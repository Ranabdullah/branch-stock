{
  "name": "branch-stock-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-15",
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "branch-stock-workspace",
    "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
  }]
}
